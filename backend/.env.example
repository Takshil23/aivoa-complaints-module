# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Groq — create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Models (assignment-mandated primary; router needs native tool calling)
PRIMARY_MODEL=gemma2-9b-it
ROUTER_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Database — pick ONE
# ---------------------------------------------------------------------------
# PostgreSQL
# DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa
# MySQL
# DATABASE_URL=mysql+pymysql://aivoa:aivoa@localhost:3306/aivoa
# SQLite (default — zero setup, for local development only)
DATABASE_URL=sqlite+pysqlite:///./aivoa.db

# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
