# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Groq — create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Models (assignment-mandated primary; router needs native tool calling).
# Groq decommissioned gemma2-9b-it on 2025-10-08 and shuts down
# llama-3.3-70b-versatile on 2026-08-16, so each role is a chain: the mandated
# model is requested first, and the fallbacks take over on model_decommissioned.
# Check console.groq.com/docs/deprecations, then `python scripts/verify_llm.py --probe`.
PRIMARY_MODEL=gemma2-9b-it
PRIMARY_MODEL_FALLBACKS=llama-3.1-8b-instant,openai/gpt-oss-20b
ROUTER_MODEL=llama-3.3-70b-versatile
ROUTER_MODEL_FALLBACKS=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Database — pick ONE
# ---------------------------------------------------------------------------
# PostgreSQL
# DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa
# MySQL
# DATABASE_URL=mysql+pymysql://aivoa:aivoa@localhost:3306/aivoa
# SQLite (default — zero setup, for local development only)
DATABASE_URL=sqlite+pysqlite:///./aivoa.db

# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
